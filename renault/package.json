{
  "name": "renault-erp",
  "version": "0.10.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "next build --webpack",
    "prebuild": "node -e \"if(!require('fs').existsSync('.env')){console.error('ERROR: Falta archivo .env. Copie .env.example a .env y configure las variables.');process.exit(1)}\"",
    "dev": "node scripts/dev.js",
    "lint": "eslint .",
    "start": "next start -p 5000",
    "start:prod": "bun run build && bun run start",
    "db:migrate": "bun run db:migrate:sqlite && bun run db:migrate:postgres",
    "db:migrate:sqlite": "prisma migrate dev --schema=prisma/sqlite/schema.prisma",
    "db:migrate:postgres": "prisma migrate dev --schema=prisma/postgres/schema.prisma",
    "db:migrate:deploy:sqlite": "prisma migrate deploy --schema=prisma/sqlite/schema.prisma",
    "db:migrate:deploy:postgres": "prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/sqlite/schema.prisma && prisma generate --schema=prisma/postgres/schema.prisma",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:sqlite": "bun prisma/seed.ts --target=sqlite",
    "db:seed-logo": "bun prisma/seed-logo.ts",
    "db:seed:postgres": "bun prisma/seed.ts --target=postgres",
    "db:seed-sqlite": "node --experimental-sqlite scripts/seed-sqlite.cjs",
    "db:setup": "bun run db:generate && bun run db:migrate && bun run db:seed",
    "db:clean": "bun scripts/clean-dbs.ts",
    "db:admin": "node scripts/seed-default-admin.js",
    "db:empty-template": "node scripts/create-empty-sqlite-db.js",
    "schema:generate": "bun scripts/generate-schemas.ts",
    "types:generate": "bun scripts/generate-types.ts",
    "db:push": "bun run db:push:sqlite && bun run db:push:postgres",
    "db:push:sqlite": "node --experimental-sqlite scripts/db-push.cjs --sqlite",
    "db:push:postgres": "node scripts/db-push-postgres.cjs",
    "db:studio:sqlite": "prisma studio --schema=prisma/sqlite/schema.prisma",
    "db:studio:postgres": "prisma studio --schema=prisma/postgres/schema.prisma",
    "db:reset": "prisma migrate reset --schema=prisma/sqlite/schema.prisma && prisma migrate reset --schema=prisma/postgres/schema.prisma",
    "dev:ws": "node lib/ws-server.js",
    "electron:dev": "node scripts/dev-electron.js",
    "electron:dev:full": "node scripts/dev-electron.js --full",
    "version:bump": "node scripts/bump-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "electron:build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/bump-version.js && node scripts/prepare-electron-db.js && bun run build && node scripts/prepare-electron-standalone.js && electron-builder",
    "electron:build:no-bump": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/prepare-electron-db.js && bun run build && node scripts/prepare-electron-standalone.js && electron-builder",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "build": {
    "appId": "com.renault.erp",
    "productName": "Renault ERP",
    "copyright": "Copyright (c) 2026 Renault Repuestos",
    "publish": [
      {
        "provider": "github",
        "owner": "jhonatan-cyber",
        "repo": "renault"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "public/**/*",
      ".next/static/**/*",
      ".next/standalone-electron/**/*",
      "node_modules/@prisma/**/*",
      "node_modules/.prisma/**/*",
      "prisma/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "public/**/*",
      ".next/standalone-electron/**/*",
      "node_modules/@libsql/**/*",
      "node_modules/cross-fetch/**/*",
      "node_modules/node-fetch/**/*",
      "node_modules/whatwg-url/**/*",
      "node_modules/tr46/**/*",
      "node_modules/webidl-conversions/**/*",
      "node_modules/js-base64/**/*",
      "node_modules/libsql/**/*",
      "node_modules/promise-limit/**/*",
      "node_modules/ws/**/*",
      "node_modules/pg/**/*",
      "node_modules/pg-cloudflare/**/*",
      "node_modules/pg-connection-string/**/*",
      "node_modules/pg-int8/**/*",
      "node_modules/pg-pool/**/*",
      "node_modules/pg-protocol/**/*",
      "node_modules/pg-types/**/*",
      "node_modules/pgpass/**/*",
      "node_modules/postgres-array/**/*",
      "node_modules/postgres-bytea/**/*",
      "node_modules/postgres-date/**/*",
      "node_modules/postgres-interval/**/*",
      "node_modules/split2/**/*",
      "node_modules/xtend/**/*",
      "node_modules/.prisma/**/*",
      "prisma/renault.db"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/renaultreluz.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Renault ERP",
      "include": "nsis/installer.nsh"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.2.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "8.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "input-otp": "1.4.2",
    "jose": "^6.2.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.5",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.83.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
    "sileo": "^0.1.5",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.1",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "@playwright/test": "^1.62.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "@prisma/config": "7.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron": "41.5.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prisma": "7.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.3.11",
  "description": "Desktop and web ERP for Renault Repuestos.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonatan-cyber/renault.git"
  },
  "author": {
    "name": "Renault Repuestos"
  }
}
