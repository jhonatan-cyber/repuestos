# Copiar a .env y completar. Nunca versionar .env real.
# SQLite local (Electron)
DATABASE_URL_LOCAL="file:./prisma/renault.db"
# Postgres web (Next.js). También se acepta DATABASE_URL_WEB como alias.
DATABASE_URL="postgresql://user:password@localhost:5432/renault"
# DATABASE_URL_WEB="postgresql://user:password@localhost:5432/renault"

PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000
CAPACITOR_USE_SERVER=true
BROWSERSLIST_IGNORE_OLD_DATA=true
RUST_LOG=info
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="<generar-secreto-64-chars>"
JWT_REFRESH_SECRET="<generar-secreto-64-chars>"
# Seed admin inicial (scripts/seed-default-admin.js). Sin esto se genera una temporal.
# SEED_ADMIN_EMAIL="admin@gmail.com"
# SEED_ADMIN_PASSWORD="<contraseña-inicial-8+-chars>"

# ─── Runtime & CORS ────────────────────────────────────────────────────────────
# APP_RUNTIME: "web" (default) | "electron"
# En modo Electron se permiten automáticamente file:// y http://localhost:*.
# En modo web, set ALLOWED_ORIGIN al dominio exacto de tu frontend (sin trailing slash).
APP_RUNTIME="web"
# ALLOWED_ORIGIN="https://mi-erp.ejemplo.com"
