generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/.prisma/client-postgres"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ============================================
// BASE SCHEMA - Single source of truth
// All models shared between SQLite and PostgreSQL
// Generated by scripts/generate-schemas.ts
// ============================================

// ============================================
// USUARIOS
// ============================================
model User {
  id        String   @id @default(uuid())
  ci        String   @unique
  firstName String
  lastName  String
  address   String
  phone     String
  email     String   @unique
  password  String
  image     String?
  role      String // "admin" | "vendedor" | "compras" | "supervisor" | "invitado"
  status    String   @default("active") // "active" | "inactive"
  createdAt DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  salesAsSeller      Sale[]       @relation("SellerSales")
  purchasesAsBuyer   Purchase[]   @relation("BuyerPurchases")
  quotationsAsSeller Quotation[]  @relation("SellerQuotations")
  commissions        Commission[]
  expenses           Expense[]
  cashRecords        CashRecord[]
  cashWithdrawals    CashWithdrawal[]
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@index([role])
  @@index([status])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([isDeleted])
  @@index([role, status])
  @@map("users")
}

// ============================================
// CLIENTES
// ============================================
model Client {
  id             String   @id @default(uuid())
  name           String
  phone          String
  address        String?
  status         String   @default("active") // "active" | "inactive"
  totalPurchases Float    @default(0)
  createdAt      DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  sales      Sale[]
  quotations Quotation[]
  credits    Credit[]

  @@index([status])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([name])
  @@index([isDeleted])
  @@index([isDeleted, status])
  @@map("clients")
}

// ============================================
// PROVEEDORES
// ============================================
model Supplier {
  id             String   @id @default(uuid())
  name           String
  company        String?
  phone          String
  email          String?
  address        String?
  totalPurchases Float    @default(0)
  createdAt      DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  products          Product[]
  purchases         Purchase[]
  purchaseCredits   PurchaseCredit[]
  supplierRequests  SupplierRequest[]

  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([name])
  @@index([isDeleted])
  @@map("suppliers")
}

// ============================================
// CATEGORÍAS
// ============================================
model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  color       String
  description String?
  type        String  @default("product") // "product" | "expense"

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  products Product[]

  @@index([type])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([isDeleted])
  @@map("categories")
}

// ============================================
// PRODUCTOS / INVENTARIO
// ============================================
model Product {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  brand         String
  model         String
  categoryId    String
  purchasePrice Float
  salePrice     Float
  stock         Int      @default(0)
  minimumStock  Int      @default(0)
  unit          String   @default("unidad")
  supplierId    String?
  status        String   @default("active") // "active" | "inactive"
  image         String?
  createdAt     DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  category       Category        @relation(fields: [categoryId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  quotationItems QuotationItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([name])
  @@index([isDeleted])
  @@index([isDeleted, categoryId])
  @@index([stock])
  @@map("products")
}

// ============================================
// VENTAS
// ============================================
model Sale {
  id             String   @id @default(uuid())
  date           DateTime
  clientId       String?
  sellerUserId   String
  subtotal       Float
  tax            Float    @default(0)
  discount       Float    @default(0)
  total          Float
  paymentMethod  String // "efectivo" | "transferencia" | "crédito" | "qr" | "mixto"
  paymentSplits  String?  // JSON array of {method, amount, reference}
  notes          String?  // Observaciones de la venta
  status         String   @default("completada") // "completada" | "pendiente" | "cancelada"
  createdAt      DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  seller        User         @relation("SellerSales", fields: [sellerUserId], references: [id])
  items         SaleItem[]
  commissions   Commission[]
  convertedFrom Quotation?   @relation("ConvertedQuotation")
  credit        Credit?

  @@index([clientId])
  @@index([sellerUserId])
  @@index([date])
  @@index([status])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([isDeleted])
  @@index([date, status])
  @@index([isDeleted, status])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Float
  subtotal  Float

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ============================================
// COMPRAS
// ============================================
model Purchase {
  id            String   @id @default(uuid())
  date          DateTime
  supplierId    String
  buyerUserId   String
  subtotal      Float
  tax           Float    @default(0)
  total         Float
  paymentMethod String   @default("efectivo") // "efectivo" | "transferencia" | "qr" | "crédito"
  status        String   @default("pendiente") // "pendiente" | "recibida" | "cancelada"
  createdAt     DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  buyer    User           @relation("BuyerPurchases", fields: [buyerUserId], references: [id])
  items    PurchaseItem[]
  credit   PurchaseCredit?

  @@index([supplierId])
  @@index([buyerUserId])
  @@index([date])
  @@index([status])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([isDeleted])
  @@index([date, status])
  @@index([isDeleted, status])
  @@map("purchases")
}

model PurchaseItem {
  id         String @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  price      Float

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ============================================
// COTIZACIONES
// ============================================
model Quotation {
  id                String   @id @default(uuid())
  date              DateTime
  clientId          String?
  externalClientName String?
  externalClientPhone String?
  sellerUserId  String
  subtotal          Float
  tax               Float    @default(0)
  discount          Float    @default(0)
  total             Float
  validUntil        DateTime
  status            String   @default("activa") // "activa" | "vencida" | "convertida"
  convertedToSaleId String?  @unique
  createdAt         DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  client            Client?              @relation(fields: [clientId], references: [id])
  seller            User                 @relation("SellerQuotations", fields: [sellerUserId], references: [id])
  items             QuotationItem[]
  convertedToSale   Sale?                @relation("ConvertedQuotation", fields: [convertedToSaleId], references: [id])
  supplierRequests  SupplierRequest[]

  @@index([clientId])
  @@index([sellerUserId])
  @@index([date])
  @@index([status])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([isDeleted])
  @@index([date, status])
  @@map("quotations")
}

model QuotationItem {
  id          String @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  price       Float
  subtotal    Float

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

// ============================================
// SOLICITUDES DE COTIZACIÓN A PROVEEDORES
// ============================================
model SupplierRequest {
  id          String   @id @default(uuid())
  quotationId String
  supplierId  String
  status      String   @default("pendiente") // "pendiente" | "enviado" | "recibido" | "respondido"
  sentAt      DateTime @default(now())
  respondedAt DateTime?
  notes       String?
  response    String? // respuesta del proveedor (precios, etc)

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier  Supplier  @relation(fields: [supplierId], references: [id])

  @@index([quotationId])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_requests")
}

// ============================================
// COMISIONES
// ============================================
model Commission {
  id         String   @id @default(uuid())
  sellerId   String
  saleId     String
  amount     Float
  percentage Float
  date       DateTime
  status     String   @default("pendiente") // "completada" | "pendiente"

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  seller User @relation(fields: [sellerId], references: [id])
  sale   Sale @relation(fields: [saleId], references: [id])

  @@index([sellerId])
  @@index([saleId])
  @@index([date])
  @@index([status])
  @@map("commissions")
}

// ============================================
// GASTOS
// ============================================
model Expense {
  id                String   @id @default(uuid())
  date              DateTime
  description       String
  amount            Float
  category          String
  responsibleUserId String
  notes             String?
  createdAt         DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  responsible User @relation(fields: [responsibleUserId], references: [id])

  @@index([date])
  @@index([responsibleUserId])
  @@index([category])
  @@index([isDeleted])
  @@index([date, category])
  @@map("expenses")
}

// ============================================
// CAJA DIARIA
// ============================================
model CashRecord {
  id             String   @id @default(uuid())
  date           DateTime
  openingBalance Float
  cashIncome     Float    @default(0)
  cashExpenses   Float    @default(0)
  closingBalance Float
  notes          String?
  userId         String
  status         String   @default("closed")
  closedAt       DateTime?

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  user        User             @relation(fields: [userId], references: [id])
  withdrawals CashWithdrawal[]

  @@index([date])
  @@index([userId])
  @@index([status])
  @@index([isDeleted])
  @@index([status, isDeleted])
  @@map("cash_records")
}

model CashWithdrawal {
  id           String   @id @default(uuid())
  cashRecordId String
  userId       String
  amount       Float
  reason       String
  createdAt    DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  cashRecord CashRecord @relation(fields: [cashRecordId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([cashRecordId])
  @@index([userId])
  @@map("cash_withdrawals")
}

// ============================================
// ROLES
// ============================================
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  permissions String
  color       String   @default("#6B7280")
  status      String   @default("active")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  @@map("roles")
}

// ============================================
// CRÉDITOS Y COBROS
// ============================================
model Credit {
  id        String   @id @default(uuid())
  saleId    String   @unique
  clientId  String
  total     Float
  balance   Float
  status    String   @default("pending") // "pending" | "paid" | "overdue"
  dueDate   DateTime
  createdAt DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  sale     Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  client   Client          @relation(fields: [clientId], references: [id])
  payments CreditPayment[]

  @@index([clientId])
  @@index([status])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([isDeleted])
  @@index([clientId, status])
  @@map("credits")
}

model CreditPayment {
  id            String   @id @default(uuid())
  creditId      String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("efectivo") // "efectivo" | "transferencia" | "qr"
  reference     String?
  notes         String?

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@map("credit_payments")
}

model PurchaseCredit {
  id         String   @id @default(uuid())
  purchaseId String   @unique
  supplierId String
  total      Float
  balance    Float
  status     String   @default("pending") // "pending" | "paid" | "overdue"
  dueDate    DateTime
  createdAt  DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  purchase Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier Supplier              @relation(fields: [supplierId], references: [id])
  payments PurchaseCreditPayment[]

  @@index([supplierId])
  @@index([status])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@index([isDeleted])
  @@index([supplierId, status])
  @@map("purchase_credits")
}

model PurchaseCreditPayment {
  id               String   @id @default(uuid())
  purchaseCreditId String
  amount           Float
  date             DateTime @default(now())
  paymentMethod    String   @default("efectivo")
  reference        String?
  notes            String?

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  // Relaciones
  purchaseCredit PurchaseCredit @relation(fields: [purchaseCreditId], references: [id], onDelete: Cascade)

  @@index([purchaseCreditId])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@map("purchase_credit_payments")
}

// ============================================
// AUDITORÍA
// ============================================
model AuditLog {
  id        String   @id @default(uuid())
  action    String   // "CREATE" | "UPDATE" | "DELETE"
  entity    String   // "purchase" | "sale" | "product" | "supplier" | etc.
  entityId  String
  userId    String?
  changes   String?  // JSON: { before, after } o descripción del cambio
  metadata  String?  // JSON: contexto adicional (impacto en caja, etc.)
  createdAt DateTime @default(now())

  // Relaciones
  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("info")
  title     String
  message   String
  entity    String?
  entityId  String?
  url       String?
  metadata  String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  // Sync Metadata
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  lastSyncedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// CONFIGURACIÓN DEL SISTEMA
// ============================================
model SystemConfig {
  id        String @id @default(uuid())
  logoMime  String? // ej. "image/png", "image/jpeg"
  logoBase64 String? // logo codificado en base64
  companyName    String @default("Renault Reluz")
  companySlogan  String @default("Repuestos automotrices")
  companyAddress String @default("Av. Confital - Av. Blanco Galindo Km 14.5")
  companyCity    String @default("Quillacollo - Cochabamba")
  companyPhone   String @default("+591 63070278")
  companyNit     String @default("000000")
  updatedAt DateTime @updatedAt

  @@map("system_config")
}
